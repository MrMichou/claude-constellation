#!/bin/sh
# Switch the claude-constellation layout in the running AwesomeWM, or switch the layer off/on.
# Usage: constellation-layout [next|prev|constellation|lanes|cards|resources|kanban|radar|strip|hud|popup|zen|treemap|flow|tree|off|on|toggle]
set -eu
case "${1:-next}" in
  -h|--help) sed -n '2,3s/^# //p' "$0"; exit 0 ;;
  next|prev|constellation|lanes|cards|resources|kanban|radar|strip|hud|popup|zen|treemap|flow|tree)
    call="cc.set_layout('${1:-next}')" ;;
  off|on|toggle)
    call="cc.set_off and (cc.set_off('$1') and 'off' or 'on') or 'error: module too old, restart awesome'" ;;
  *) echo "constellation-layout: unknown layout '$1'" >&2; sed -n '3s/^# //p' "$0" >&2; exit 2 ;;
esac
out=$(awesome-client "local ok, cc = pcall(require, 'ui.desktop.claude_constellation')
  if not ok or not cc.set_layout then return 'error: module not loaded' end
  return $call")
# awesome-client prints e.g.:   string "cards"
layout=$(printf '%s\n' "$out" | sed -n 's/.*string "\(.*\)".*/\1/p')
case "$layout" in
  ""|error:*) echo "constellation-layout: ${layout:-no answer from awesome-client}" >&2; exit 1 ;;
  *) echo "$layout" ;;
esac
