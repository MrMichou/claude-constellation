#!/usr/bin/env node
// Terminal menu for every claude-constellation setting of the running AwesomeWM: the layer on/off,
// the layout, eco mode, the render backend, Promview (poll now, sign in), Grafana (poll now, token)
// and the lock screen.
// Usage: constellation-menu
//
// Keys: up/down (or k/j) pick a line, left/right (or h/l) change its value, which applies at once
// so the wallpaper previews it; enter runs an action (or steps a value); q or esc quits.
// "Choose layouts…" opens a checklist of every layout: space or enter enables/disables the one
// picked (left out of the Layout line and of next/prev), q or esc goes back.
// Talks to Awesome through awesome-client, like constellation-layout and constellation-eco.

const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawn, spawnSync } = require("child_process");

if (process.argv[2] === "-h" || process.argv[2] === "--help") {
  console.log("Terminal menu for every claude-constellation setting.\nUsage: constellation-menu");
  process.exit(0);
}

const LAYOUT_HELP = {
  constellation: "glowing nodes, their resources in orbit",
  lanes: "one lane per session, its tool calls over 20 min",
  cards: "a grid of cards and a summary tile",
  resources: "files, commands and tmux in the middle, sessions around",
  kanban: "columns Needs you / Working / Done / Asleep",
  radar: "the last 30 min as a clock face, the most urgent in the middle",
  strip: "a band across the top, one chip per session",
  hud: "a column on the right edge (and the Promview / Grafana board)",
  popup: "the session list as a key binding would show it",
  zen: "one dot per session; only who needs you is spelled out",
  treemap: "tiles sized by time in tool calls over 30 min",
  flow: "Sankey: sessions -> kinds of tool -> resources",
  tree: "icicle: session -> calls and subagents -> targets",
  "obsi-constellation": "the Obsidian vault's graph, the notes read and edited lit up",
};
const ECO_HELP = { auto: "on while on battery", on: "nothing moves, 1 frame/s", off: "full animation" };
const BACKEND_HELP = { auto: "the GPU if there is one", gpu: "draw on the X surface", cpu: "draw in memory, one paint" };

// --- Awesome --------------------------------------------------------------------------------

// Runs `action` (Lua, may be empty) in Awesome, then answers the state in one round trip.
const STATE = `
  local e, eon = cc.eco and cc.eco()
  local b, bnow = cc.backend and cc.backend()
  -- an unknown name leaves the layout alone and returns it (modules without cc.layout)
  local l = cc.layout and cc.layout() or cc.set_layout('?')
  return table.concat({ l, tostring(cc.is_off and cc.is_off() or false), tostring(e or ''),
    tostring(eon or false), tostring(b or ''), tostring(bnow or ''), table.concat(cc.layouts or {}, ','),
    table.concat(cc.hidden_layouts and cc.hidden_layouts() or {}, ','),
    tostring(cc.set_layout_enabled ~= nil) }, '|')`;

function awesome(action) {
  const lua = `local ok, cc = pcall(require, 'ui.desktop.claude_constellation')
  if not ok or not cc.set_layout then return 'error: module not loaded' end
  ${action || ""}
  ${STATE}`;
  const r = spawnSync("awesome-client", [lua], { encoding: "utf8" });
  if (r.error) throw new Error(`awesome-client: ${r.error.code === "ENOENT" ? "not found" : r.error.message}`);
  // awesome-client prints e.g.:   string "kanban|false|auto|false|auto|gpu|constellation,lanes"
  const m = (r.stdout || "").match(/string "(.*)"/);
  if (!m) throw new Error("no answer from awesome-client");
  if (m[1].startsWith("error:")) throw new Error(m[1].slice(7));
  const [layout, off, eco, ecoOn, backend, backendNow, layouts, hidden, canHide] = m[1].split("|");
  return {
    layout, off: off === "true", eco, ecoOn: ecoOn === "true", backend, backendNow,
    layouts: layouts ? layouts.split(",") : Object.keys(LAYOUT_HELP),
    hidden: hidden ? hidden.split(",") : [],
    canHide: canHide === "true", // false: a module too old for set_layout_enabled
  };
}

function promviewConf() {
  const dir = process.env.XDG_CONFIG_HOME || path.join(os.homedir(), ".config");
  let text = "";
  try { text = fs.readFileSync(path.join(dir, "claude-constellation", "promview.conf"), "utf8"); } catch {}
  const conf = { url: process.env.PROMVIEW_URL || "", desktop: "auto" };
  for (const line of text.split("\n")) {
    const m = line.replace(/#.*/, "").match(/^\s*(url|desktop)\s*=\s*(.*?)\s*$/);
    if (m && !(m[1] === "url" && process.env.PROMVIEW_URL)) conf[m[1]] = m[2].replace(/^"(.*)"$/, "$1");
  }
  return conf;
}

// grafana.conf's url (the global keys come before the first [graph] section).
function grafanaUrl() {
  const dir = process.env.XDG_CONFIG_HOME || path.join(os.homedir(), ".config");
  let text = "";
  try { text = fs.readFileSync(path.join(dir, "claude-constellation", "grafana.conf"), "utf8"); } catch {}
  let url = process.env.GRAFANA_URL || "";
  for (const line of text.split("\n")) {
    if (/^\s*\[/.test(line)) break;
    const m = line.replace(/\s#.*/, "").match(/^\s*url\s*=\s*(.*?)\s*$/);
    if (m && !process.env.GRAFANA_URL) url = m[1].replace(/^"(.*)"$/, "$1");
  }
  return url;
}

// --- Menu -----------------------------------------------------------------------------------

const lua = (s) => `'${s.replace(/[\\']/g, "\\$&")}'`;
let state;
let conf = promviewConf();
let grafana = grafanaUrl();
let row = 0;
let message = "";
let picking = false; // the layout checklist is open
let pick = 0; // its line

// The Layout line steps through the enabled layouts (and the one shown, even if disabled).
const enabledLayouts = () => state.layouts.filter((l) => !state.hidden.includes(l) || l === state.layout);

// A choice line steps through `options` with left/right; an action line runs on enter.
const ROWS = [
  { label: "Display", options: () => ["on", "off"], value: () => (state.off ? "off" : "on"),
    apply: (v) => `cc.set_off(${lua(v)})`, hint: (v) => (v === "off" ? "hidden, no redraws" : "drawn on the desktop") },
  { label: "Layout", options: enabledLayouts, value: () => state.layout,
    apply: (v) => `cc.set_layout(${lua(v)})`, hint: (v) => LAYOUT_HELP[v] || "" },
  { label: "", action: "Choose layouts…",
    hint: () => `${state.layouts.length - state.hidden.length}/${state.layouts.length} enabled in the Layout line and next/prev`,
    run: openPicker },
  { label: "Eco mode", options: () => ["auto", "on", "off"], value: () => state.eco,
    apply: (v) => `cc.set_eco(${lua(v)})`,
    hint: (v) => ECO_HELP[v] + (v === "auto" ? (state.ecoOn ? " (on now)" : " (off now)") : "") },
  { label: "Rendering", options: () => ["auto", "gpu", "cpu"], value: () => state.backend,
    apply: (v) => `cc.set_backend(${lua(v)})`,
    hint: (v) => BACKEND_HELP[v] + (state.backendNow ? ` (in use: ${state.backendNow})` : "") },
  { label: "Promview", action: "Poll now",
    hint: () => (conf.url ? conf.url : "no url") + ` · desktop ${conf.desktop}`,
    run: () => { conf = promviewConf(); act("if cc.promview_refresh then cc.promview_refresh() end", "Polled Promview"); } },
  { label: "", action: "Sign in…", hint: () => (conf.url ? "OIDC sign-in in your browser" : "set url in promview.conf first"),
    run: signIn },
  { label: "Grafana", action: "Poll now", hint: () => grafana || "no url: set url in grafana.conf",
    run: () => { grafana = grafanaUrl(); act("if cc.grafana_refresh then cc.grafana_refresh() end", "Polled Grafana"); } },
  { label: "", action: "Set token…", hint: () => (grafana ? "service account token, kept in the keyring" : "set url in grafana.conf first"),
    run: () => external("constellation-grafana-token", "Grafana token stored", "No token stored") },
  { label: "Lock screen", action: "Lock now", hint: () => "xsecurelock on the constellation",
    run: () => { act("cc.lock()", "Locked"); quit(); } },
  { label: "", action: "Quit", hint: () => "", run: () => quit() },
];

const tty = process.stdout.isTTY;
const c = (code, s) => (tty ? `\x1b[${code}m${s}\x1b[0m` : s);
const pad = (s, n) => s + " ".repeat(Math.max(0, n - [...s].length));

function drawPicker() {
  const lines = ["", `  ${c("1;38;5;111", "✦ Claude constellation")}  ${c("2", "· layouts")}`, ""];
  state.layouts.forEach((l, i) => {
    const sel = i === pick;
    const cursor = sel ? c("38;5;111", "▸") : " ";
    const on = !state.hidden.includes(l);
    const box = on ? c("38;5;114", "[x]") : c("2", "[ ]");
    const name = pad(l, 20) + (l === state.layout ? "•" : " ");
    lines.push(`  ${cursor} ${box} ${sel ? c("1;38;5;111", name) : on ? name : c("2", name)}  ${c("2", LAYOUT_HELP[l] || "")}`);
  });
  lines.push("", c("2", "  ↑↓ choose   space/⏎ enable/disable   • shown now   q back"), "", message ? `  ${message}` : "");
  if (tty) process.stdout.write("\x1b[H\x1b[2J" + lines.join("\n"));
}

function openPicker() {
  if (!state.canHide) { message = c("38;5;221", "Restart Awesome to load a module that can disable layouts"); return; }
  picking = true;
  pick = Math.max(0, state.layouts.indexOf(state.layout));
}

function togglePicked() {
  const l = state.layouts[pick];
  const on = state.hidden.includes(l);
  if (!on && state.layouts.length - state.hidden.length <= 1) {
    message = c("38;5;221", `${l} is the last layout enabled`); return;
  }
  act(`cc.set_layout_enabled(${lua(l)}, ${on})`, `${l}: ${on ? "enabled" : "disabled"}`);
}

function pickerKey(k) {
  const n = state.layouts.length;
  if (k === "\x1b[A" || k === "k") pick = (pick + n - 1) % n;
  else if (k === "\x1b[B" || k === "j" || k === "\t") pick = (pick + 1) % n;
  else if (k === " " || k === "\r" || k === "\n" || k === "\x1b[D" || k === "\x1b[C" || k === "h" || k === "l") togglePicked();
  else if (k === "q" || k === "\x1b") picking = false;
}

function draw() {
  if (picking) return drawPicker();
  const lines = ["", `  ${c("1;38;5;111", "✦ Claude constellation")}`, ""];
  ROWS.forEach((r, i) => {
    const sel = i === row;
    const cursor = sel ? c("38;5;111", "▸") : " ";
    let value;
    if (r.options) {
      const opts = r.options(), v = r.value();
      const pos = c("2", pad(opts.length > 2 ? `${opts.indexOf(v) + 1}/${opts.length}` : "", 7));
      value = pad(`‹ ${v} ›`, 19);
      lines.push(`  ${cursor} ${pad(r.label, 12)}${sel ? c("1;38;5;111", value) : value}${pos}${c("2", r.hint(v))}`);
    } else {
      value = pad(r.action, 19);
      lines.push(`  ${cursor} ${pad(r.label, 12)}${sel ? c("1;38;5;111", value) : value}       ${c("2", r.hint())}`);
    }
  });
  lines.push("", c("2", "  ↑↓ choose   ←→ change   ⏎ apply   q quit"), "", message ? `  ${message}` : "");
  if (tty) process.stdout.write("\x1b[H\x1b[2J" + lines.join("\n"));
}

function act(action, done) {
  try {
    state = awesome(action);
    message = done ? c("38;5;114", done) : "";
  } catch (err) {
    message = c("38;5;203", err.message);
  }
}

function step(dir) {
  const r = ROWS[row];
  if (!r.options) return;
  const opts = r.options();
  const v = opts[(opts.indexOf(r.value()) + dir + opts.length) % opts.length];
  act(r.apply(v), `${r.label}: ${v}`);
}

function screen(on) {
  if (!tty) return;
  process.stdout.write(on ? "\x1b[?1049h\x1b[?25l" : "\x1b[?25h\x1b[?1049l");
}

function rawMode(on) {
  if (process.stdin.isTTY) process.stdin.setRawMode(on);
}

let quitting = false;
function quit() {
  quitting = true;
  rawMode(false);
  screen(false);
  process.exit(0);
}

let paused = false;
function signIn() {
  if (!conf.url && !promviewConf().url) { message = c("38;5;221", "No Promview url: set url = … in promview.conf"); return; }
  external("constellation-promview-login", "Signed in to Promview", "Sign-in failed");
}

// Hand the terminal to one of our commands, then come back to the menu.
function external(name, ok, failed) {
  if (name === "constellation-grafana-token" && !grafanaUrl()) {
    message = c("38;5;221", "No Grafana url: set url = … in grafana.conf"); return;
  }
  const cmd = path.join(path.dirname(fs.realpathSync(__filename)), name);
  paused = true;
  rawMode(false);
  screen(false);
  process.stdin.pause();
  const child = spawn(cmd, [], { stdio: "inherit" });
  child.on("close", (code) => {
    paused = false;
    message = code === 0 ? c("38;5;114", ok) : c("38;5;203", `${failed} (${code})`);
    conf = promviewConf();
    grafana = grafanaUrl();
    rawMode(true);
    screen(true);
    process.stdin.resume();
    draw();
  });
}

function key(k) {
  if (paused) return;
  message = "";
  if (k === "\x03") return quit();
  if (picking) { pickerKey(k); if (!quitting && !paused) draw(); return; }
  if (k === "\x1b[A" || k === "k") row = (row + ROWS.length - 1) % ROWS.length;
  else if (k === "\x1b[B" || k === "j" || k === "\t") row = (row + 1) % ROWS.length;
  else if (k === "\x1b[D" || k === "h") step(-1);
  else if (k === "\x1b[C" || k === "l" || k === " ") step(1);
  else if (k === "\r" || k === "\n") ROWS[row].run ? ROWS[row].run() : step(1);
  else if (k === "q" || k === "\x1b" || k === "\x03") quit();
  else if (/^[1-9]$/.test(k) && +k <= ROWS.length) row = +k - 1;
  if (!quitting && !paused) draw();
}

try {
  state = awesome("");
} catch (err) {
  console.error(`constellation-menu: ${err.message}`);
  process.exit(1);
}
screen(true);
rawMode(true);
process.on("exit", () => { if (!quitting) { rawMode(false); screen(false); } });
process.stdout.on("resize", draw);
draw();
process.stdin.setEncoding("utf8");
// A paste or a pipe may bring several keys at once: split escape sequences from single keys.
process.stdin.on("data", (chunk) => {
  for (const k of chunk.match(/\x1b\[[A-D]|\x1b|[\s\S]/g) || []) key(k);
});
process.stdin.on("end", () => { if (!paused) quit(); });
